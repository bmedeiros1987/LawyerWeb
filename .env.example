DATABASE_URL="postgresql://mblz:mblz@localhost:5432/mblz?schema=public"
AUTH_SECRET="replace-me"
AUTH_GOOGLE_ID="replace-me.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="replace-me"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
TOKEN_ENCRYPTION_KEY="replace-with-32-byte-base64-key"
CRON_SECRET="replace-me"

# Gmail -> Cloud Pub/Sub
GOOGLE_GMAIL_PUBSUB_TOPIC="projects/PROJECT_ID/topics/mblz-gmail"
GOOGLE_PUBSUB_AUDIENCE="https://YOUR_APP_DOMAIN/api/webhooks/google-gmail"

# Web Push / PWA
NEXT_PUBLIC_VAPID_PUBLIC_KEY="replace-me"
VAPID_PRIVATE_KEY="replace-me"
VAPID_SUBJECT="mailto:security@example.com"

# MBLZ Agent / OpenClaw
OPENCLAW_GATEWAY_URL="https://mblz-agent-gateway.onrender.com"
OPENCLAW_GATEWAY_TOKEN="replace-me"
OPENCLAW_AGENT_ID="mblz"
OPENCLAW_SESSION_SALT="replace-with-random-32-byte-secret"\nMBLZ_AGENT_SERVICE_TOKEN="replace-with-random-service-secret"
