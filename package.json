{
  "name": "lawyerweb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "ci": "npm run db:validate && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "latest",
    "google-auth-library": "latest",
    "googleapis": "182.0.0",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.32",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest",
    "lucide-react": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prisma": "7.10.0",
    "typescript": "latest"
  }
}