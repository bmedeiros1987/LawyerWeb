{
  "name": "lawyerweb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "ci": "npm run db:validate && npm test && npm run typecheck && npm run build",
    "test": "vitest run",
    "test:browser": "node scripts/document-editor-browser.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "docx": "9.8.1",
    "dotenv": "latest",
    "google-auth-library": "latest",
    "googleapis": "182.0.0",
    "lucide-react": "latest",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "8.0.11",
    "pdf-lib": "1.17.1",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "web-push": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/web-push": "latest",
    "jszip": "3.10.2",
    "prisma": "7.10.0",
    "typescript": "latest",
    "vitest": "^3.2.4"
  }
}
