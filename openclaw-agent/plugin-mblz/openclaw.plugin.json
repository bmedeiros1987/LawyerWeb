{
  "id": "mblz",
  "name": "MBLZ Legal OS",
  "description": "Read-only, identity-bound context bridge from OpenClaw channels to MBLZ Legal OS.",
  "contracts": {
    "tools": ["mblz_context"]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiUrl": { "type": "string" },
      "serviceToken": { "type": "string" }
    },
    "required": ["apiUrl", "serviceToken"]
  }
}
